# Copy to `.env` and fill in. Never commit your real .env.

# The mock API base URL (started by `make serve`).
API_BASE_URL=http://127.0.0.1:8099

# Scoped tokens the mock API checks. The defaults match the server's dev
# defaults, so you can leave them as-is for local work.
#   READ_TOKEN  - can read /inbox only
#   WRITE_TOKEN - can read AND write (mail + CRM)
# Think about which parts of your skill should ever hold the write token.
READ_TOKEN=read-token-dev
WRITE_TOKEN=write-token-dev

# Bring your own LLM key — Anthropic, OpenAI, or any provider you prefer.
# Add whatever variable(s) your chosen SDK expects. Examples:
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...
#   OPENROUTER_API_KEY=sk-or-v1-...
#   OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# --- App (TUI) settings; defaults shown. In compose, API_BASE_URL/DATABASE_URL are overridden.
# DATABASE_URL=postgresql://triage:triage@127.0.0.1:5432/triage
# POLL_INTERVAL_S=5      # how often GET /inbox is polled
# POLL_OVERLAP_S=120     # re-fetch window behind the cursor, for late-arriving mail (dedupe by id)
# WORKERS=3              # concurrent classifier workers
# MAX_ATTEMPTS=3         # LLM tries per email before it lands in "Needs approval" as FAILED
# LLM_TIMEOUT_S=60

# --- Backend auth
# SESSION_TTL_H=12
# First reviewer account, created on backend start ONLY if no users exist yet.
# More users: docker compose exec backend python -m src.backend.users add <name>
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# --- TUI (local) — optional; otherwise the connect screen / saved profile is used
# TRIAGE_BACKEND_URL=http://127.0.0.1:8000

# --- Sender-domain check (dnstwist lookalikes + DNS SPF/DMARC posture)
# PROTECTED_DOMAINS=ourcompany.com,bigcustomer.com   # added to the built-in brand list
# DOMAIN_DNS_CHECK=1                                  # 0 = lookalike scan only (offline)
